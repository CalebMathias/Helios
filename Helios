                            blood_sugar, cholesterol, weight, bmi, risk_score, age, complaint_severity], dtype=np.float32)
        for source in CONFIG.risk_intel_sources:
            try:
                headers = {"x-apikey": source["key"]} if "publichealth" in source["url"] else {"Key": source["key"], "Accept": "application/json"}
