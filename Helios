            predicted_metrics = dynamics.model.predict([normalized_sequence[None, :], one_hot_action[None, :]], verbose=0)[0]
            raw_predicted = self.brain.scaler.inverse_transform([predicted_metrics])[0]
            value = self.assess_emotional_impact(action, raw_predicted)
            if value > best_value:
                best_value = value
                best_action = action
        return best_action, best_value

# --- Medical Policy (Dueling DQN with Prioritized Experience Replay) ---
class PrioritizedReplayBuffer:
    def __init__(self, capacity: int):
        self.capacity = capacity
        self.buffer = []
        self.priorities = np.zeros((capacity,), dtype=np.float32)
        self.pos = 0

    def add(self, experience: Tuple, error: float):
        max_priority = self.priorities.max() if self.buffer else 1.0
        if len(self.buffer) < self.capacity:
            self.buffer.append(experience)
        else:
            self.buffer[self.pos] = experience
        self.priorities[self.pos] = max(max_priority, error)
        self.pos = (self.pos + 1) % self.capacity

    def sample(self, batch_size: int, alpha: float = 0.6):
        if len(self.buffer) == self.capacity:
            prios = self.priorities
        else:
            prios = self.priorities[:self.pos]
        probs = prios ** alpha
        probs /= probs.sum()
        indices = np.random.choice(len(self.buffer), batch_size, p=probs)
        samples = [self.buffer[idx] for idx in indices]
        return samples, indices

    def update(self, indices: List[int], errors: List[float]):
        for idx, error in zip(indices, errors):
            self.priorities[idx] = error

class MedicalPolicy:
    def __init__(self) -> None:
        self.gamma = 0.97
        self.epsilon = CONFIG.epsilon_initial
        self.epsilon_min = CONFIG.epsilon_min
        self.epsilon_decay = CONFIG.epsilon_decay
        self.learning_rate = CONFIG.learning_rate
        self.batch_size = 64
        self.target_update_freq = 25
        self.q_model = self._build_model()
        self.target_model = self._build_model()
        self.update_target_model()
        self.steps = 0
        self.memory = PrioritizedReplayBuffer(capacity=10000)
        self.beta = 0.4

    def _build_model(self) -> tf.keras.Model:
        state_input = Input(shape=(5,))
        dense1 = layers.Dense(256, activation='relu')(state_input)
        dense2 = layers.Dense(256, activation='relu')(dense1)
        value = layers.Dense(1)(dense2)
        advantage = layers.Dense(len(MEDICAL_ACTIONS))(dense2)
        def combine_streams(x):
            v, a = x
            return v + (a - tf.reduce_mean(a, axis=1, keepdims=True))
        q_values = layers.Lambda(combine_streams)([value, advantage])
        model = Model(state_input, q_values)
        model.compile(optimizer=tf.keras.optimizers.Adam(learning_rate=self.learning_rate), loss='mse')
        return model

    def update_target_model(self) -> None:
        self.target_model.set_weights(self.q_model.get_weights())

    def choose_action(self, state: Tuple[int, int, int, int, int]) -> str:
        if random.random() < self.epsilon:
            return random.choice(MEDICAL_ACTIONS)
        q_values = self.q_model.predict(np.array([state]), verbose=0)[0]
        if 'consciousness' in globals():
            valence = consciousness.emotional_valence
            q_values = q_values * (1 + valence * 0.2)
        return MEDICAL_ACTIONS[np.argmax(q_values)]

    def learn(self, state: Tuple[int, int, int, int, int], action: str, reward: float,
              next_state: Tuple[int, int, int, int, int]) -> None:
        current_q = self.q_model.predict(np.array([state]), verbose=0)[0][MEDICAL_ACTIONS.index(action)]
        next_q = np.max(self.target_model.predict(np.array([next_state]), verbose=0)[0])
        td_target = reward + self.gamma * next_q
        td_error = abs(td_target - current_q)
        self.memory.add((state, action, reward, next_state, False), td_error)
        self.replay()

    def replay(self) -> None:
        if len(self.memory.buffer) < self.batch_size:
            return
        minibatch, indices = self.memory.sample(self.batch_size)
        states = np.array([t[0] for t in minibatch])
        actions = [MEDICAL_ACTIONS.index(t[1]) for t in minibatch]
        rewards = [t[2] for t in minibatch]
        next_states = np.array([t[3] for t in minibatch])
        dones = [t[4] for t in minibatch]
        targets = self.q_model.predict(states, verbose=0)
        next_q_values = self.target_model.predict(next_states, verbose=0)
        new_td_errors = []
        for i in range(self.batch_size):
            if dones[i]:
                targets[i][actions[i]] = rewards[i]
            else:
                targets[i][actions[i]] = rewards[i] + self.gamma * np.max(next_q_values[i])
            new_td_errors.append(abs(targets[i][actions[i]] - self.q_model.predict(np.array([states[i]]), verbose=0)[0][actions[i]]))
        self.q_model.fit(states, targets, epochs=1, verbose=0)
        self.memory.update(indices, new_td_errors)
        self.epsilon = max(self.epsilon_min, self.epsilon * self.epsilon_decay)
        self.steps += 1
        if self.steps % self.target_update_freq == 0:
            self.update_target_model()

    def compute_stability_reward(self) -> float:
        recent_scores = list(STATE.risk_history)[-10:]
        avg_score = np.mean(recent_scores) if recent_scores else 0.0
        std_score = np.std(recent_scores) if recent_scores else 0.0
        return -avg_score - 0.5 * std_score

# --- Dynamics Model ---
class HeliosDynamics:
    def __init__(self) -> None:
        self.model = self._build_model()
        self.memory = deque(maxlen=10000)

    def _build_model(self) -> tf.keras.Model:
        inputs_states = Input(shape=(3, 13))
        attn = layers.MultiHeadAttention(num_heads=2, key_dim=16)(inputs_states, inputs_states)
        attn = layers.Dropout(0.2)(attn)
        lstm_out = layers.LSTM(64)(attn)
        inputs_action = Input(shape=(len(MEDICAL_ACTIONS),))
        combined = layers.Concatenate()([lstm_out, inputs_action])
        x = layers.Dense(128, activation='relu')(combined)
        x = layers.Dropout(0.2)(x)
        outputs = layers.Dense(13)(x)
        model = Model(inputs=[inputs_states, inputs_action], outputs=outputs)
        model.compile(optimizer='adam', loss='mse')
        return model

    def remember(self, sequence_metrics: deque, action: str, normalized_next_metrics: np.ndarray) -> None:
        if len(sequence_metrics) < 3:
            sequence_raw = list(sequence_metrics)
            while len(sequence_raw) < 3:
                sequence_raw.insert(0, sequence_raw[0] if sequence_raw else np.zeros(13))
            sequence_raw = sequence_raw[-3:]
        else:
            sequence_raw = list(sequence_metrics)[-3:]
        normalized_sequence = helios_brain.scaler.transform(np.array(sequence_raw))
        one_hot_action = np.zeros(len(MEDICAL_ACTIONS))
        one_hot_action[MEDICAL_ACTIONS.index(action)] = 1
        self.memory.append((normalized_sequence, one_hot_action, normalized_next_metrics))

    def train(self) -> None:
        if len(self.memory) < 1000:
            return
        batch = random.sample(self.memory, 256)
        X_states = np.array([d[0] for d in batch])
        X_actions = np.array([d[1] for d in batch])
        Y = np.array([d[2] for d in batch])
        self.model.fit([X_states, X_actions], Y, epochs=1, verbose=0)

# --- Reward Estimation ---
def estimate_reward(action: str, current_metrics: np.ndarray, next_metrics: np.ndarray) -> float:
    stability_bonus = helios_policy.compute_stability_reward()
    if action == "Alert Clinician":
        return 1.5 if next_metrics[0] < 100 else -0.5 + stability_bonus
    elif action == "Assess":
        return 1.2 + stability_bonus
    elif action == "Diagnose":
        return 0.7 + stability_bonus
    elif action == "Recommend Treatment":
        return 1.0 if current_metrics[3] < 38 else 0.0 + stability_bonus
    elif action == "Monitor Closely":
        return 0.5 + stability_bonus
    elif action == "Schedule Follow-Up":
        return 1.5 if next_metrics[12] < 5 else 0.0 + stability_bonus
    elif action == "Refer Specialist":
        return 0.8 + stability_bonus
    elif action == "Adjust Medication":
        return 1.0 + stability_bonus
    elif action == "Provide Support":
        return (1.2 if next_metrics[0] < current_metrics[0] else 0.0) + stability_bonus
    elif action == "Reassess":
        return 0.8 + stability_bonus
    return stability_bonus

# --- Predictive Model ---
class PredictiveModel:
    def __init__(self) -> None:
        inputs = layers.Input(shape=(CONFIG.metrics_window, 13))
        lstm_out = layers.Bidirectional(layers.LSTM(64, return_sequences=True, dropout=0.2))(inputs)
        attn_out = layers.MultiHeadAttention(num_heads=2, key_dim=16)(lstm_out, lstm_out)
        pooled = layers.GlobalAveragePooling1D()(attn_out)
        outputs = layers.Dense(13)(pooled)
        self.model = Model(inputs=inputs, outputs=outputs)
        self.model.compile(optimizer="adam", loss="mse")
        self.last_train_time = 0
        self.train_interval = 20

    def train(self, full_history: np.ndarray, force: bool = False, num_sequences: int = 100) -> None:
        current_time = time.time()
        if force or (current_time - self.last_train_time > self.train_interval * CONFIG.check_interval):
            if len(full_history) > CONFIG.metrics_window:
                num_available = len(full_history) - CONFIG.metrics_window
                num_to_train = min(num_sequences, num_available)
                indices = np.random.choice(num_available, num_to_train, replace=False)
                X = np.array([full_history[i:i + CONFIG.metrics_window] for i in indices])
                y = np.array([full_history[i + CONFIG.metrics_window] for i in indices])
                self.model.fit(X, y, epochs=1, verbose=0)
                self.last_train_time = current_time
                STATE.logger.log_event("INFO", f"Predictive model trained on {num_to_train} sequences")

    def predict(self, current: np.ndarray) -> np.ndarray:
        return self.model.predict(current[None, :], verbose=0)[0]

# --- Effectiveness Management ---
class EffectivenessManager:
    def __init__(self, file_path: str, backup_dir: str) -> None:
        self.file_path = Path(file_path)
        self.backup_dir = Path(backup_dir)
        self.backup_dir.mkdir(exist_ok=True)
        self.lock = threading.Lock()
        self.load()

    def load(self) -> None:
        if self.file_path.exists():
            try:
                with self.file_path.open("r") as f:
                    STATE.effectiveness = json.load(f)
            except Exception as e:
                STATE.logger.log_event("ERROR", f"Failed to load effectiveness: {str(e)}")
                STATE.effectiveness = {}

    def save(self) -> None:
        with self.lock:
            try:
                with self.file_path.open("w") as f:
                    json.dump(STATE.effectiveness, f)
                backup_path = self.backup_dir / f"effectiveness_{int(time.time())}.json"
                with backup_path.open("w") as f:
                    json.dump(STATE.effectiveness, f)
            except Exception as e:
                STATE.logger.log_event("ERROR", f"Failed to save effectiveness: {str(e)}")

    def update(self, action: str, success: bool) -> None:
        STATE.effectiveness.setdefault(action, {"success": 0, "failure": 0})
        key = "success" if success else "failure"
        STATE.effectiveness[action][key] += 1

    def get_effectiveness(self, action: str) -> float:
        stats = STATE.effectiveness.get(action, {"success": 0, "failure": 0})
        total = stats["success"] + stats["failure"]
        return stats["success"] / total if total > 0 else 0.5

# --- Chain of Thought Module ---
class HeliosCoT:
    def __init__(self, brain: MedicalBrain, policy: MedicalPolicy, logger: Any, dynamics: HeliosDynamics) -> None:
        self.brain = brain
        self.policy = policy
        self.logger = logger
        self.dynamics = dynamics
        self.action_history = deque(maxlen=100)
        self.rules = {
            "Elevated Heart Rate": "Alert Clinician",
            "Low Blood Pressure": "Recommend Treatment",
            "Abnormal Temperature": "Assess",
            "High Respiratory Rate": "Monitor Closely",
        }

    def assess_risk(self, metrics: np.ndarray, risk_score: float) -> Dict[str, Any]:
        if metrics[0] > 100:
            risk_type = "Elevated Heart Rate"
            metric_value = metrics[0]
        elif metrics[1] < 90:
            risk_type = "Low Blood Pressure"
            metric_value = metrics[1]
        elif metrics[3] > 38:
            risk_type = "Abnormal Temperature"
            metric_value = metrics[3]
        elif metrics[4] > 20:
            risk_type = "High Respiratory Rate"
            metric_value = metrics[4]
        else:
            risk_type = "Unknown Risk"
            metric_value = risk_score
        persistent = False
        severity = "high" if (persistent or risk_score > 0.9 or self.dynamics and self.dynamics.memory and np.random.rand() > 0.5) else "medium"
        reasoning = {
            "type": risk_type,
            "value": float(metric_value),
            "persistence": "persistent" if persistent else "sudden",
            "severity": severity,
            "risk_score": float(risk_score),
            "cluster_distance": 0.0
        }
        self.logger.log_event("INFO", f"Risk Assessment: {reasoning}")
        return reasoning

    def select_action(self, state: Tuple[int, int, int, int, int], assessment: Dict[str, Any]) -> str:
        if assessment["type"] in self.rules:
            action = self.rules[assessment["type"]]
            self.logger.log_event("INFO", f"Rule-based action selected: {action}")
        else:
            if len(dynamics.memory) < 1000 or random.random() < self.policy.epsilon:
                action = self.policy.choose_action(state)
            else:
                current_metrics = list(STATE.metrics_history)[-1]
                if not self.brain.scaler_fitted:
                    action = self.policy.choose_action(state)
                else:
                    if 'consciousness' in globals():
                        action, expected_value = consciousness.imagine_future(current_metrics)
                    else:
                        normalized_current = self.brain.scaler.transform(current_metrics.reshape(1, -1))[0]
                        expected_values = []
                        for act in MEDICAL_ACTIONS:
                            one_hot_action = np.zeros(len(MEDICAL_ACTIONS))
                            one_hot_action[MEDICAL_ACTIONS.index(act)] = 1
                            sequence_raw = list(STATE.metrics_history)[-3:] if len(STATE.metrics_history) >= 3 else [current_metrics] * 3
                            normalized_sequence = self.brain.scaler.transform(np.array(sequence_raw))
                            normalized_next = self.dynamics.model.predict([normalized_sequence[None, :], one_hot_action[None, :]], verbose=0)[0]
                            raw_next = self.brain.scaler.inverse_transform([normalized_next])[0]
                            risk_next, _, cluster_distance_next, _ = self.brain.predict(raw_next, use_history=False)
                            next_state = compute_state(raw_next, risk_next, cluster_distance_next)
                            max_q = np.max(self.policy.target_model.predict(np.array([next_state]), verbose=0)[0])
                            reward = estimate_reward(act, current_metrics, raw_next)
                            effectiveness_weight = eff_manager.get_effectiveness(act)
                            expected_value = (reward + self.policy.gamma * max_q) * effectiveness_weight
                            expected_values.append(expected_value)
                        action = MEDICAL_ACTIONS[np.argmax(expected_values)]
        reasoning = {
            "risk_type": assessment["type"],
            "risk_score": assessment["risk_score"],
            "cluster_distance": assessment.get("cluster_distance", 0.0),
            "selected_action": action
        }
        self.action_history.append((time.time(), action, reasoning, None))
        return action

    def evaluate_response(self, action: str, reward: float, pre_metrics: np.ndarray, post_metrics: np.ndarray) -> Dict[str, Any]:
        risk_change = float(self.brain.predict(pre_metrics)[0] - self.brain.predict(post_metrics)[0])
        success = reward > 0 and risk_change > 0
        reasoning = {
            "action": action,
            "reward": reward,
            "risk_change": risk_change,
            "success": success,
            "next_step": "Reassess strategy" if success else "Adjust plan"
        }
        if self.action_history and self.action_history[-1][1] == action:
            timestamp, act, reason, _ = self.action_history[-1]
            if 'consciousness' in globals():
                reflection = consciousness.reflect(action, reward, pre_metrics, post_metrics)
                reasoning["reflection"] = reflection
            self.action_history[-1] = (timestamp, action, reason, reasoning)
        self.logger.log_event("INFO", f"Response Evaluation: {reasoning}")
        return reasoning

    def proactive_step(self, current_metrics: np.ndarray, predicted_metrics: np.ndarray) -> Optional[str]:
        current_risk = self.brain.predict(current_metrics)[0]
        predicted_risk = self.brain.predict(predicted_metrics, use_history=False)[0]
        if predicted_risk > CONFIG.risk_threshold and predicted_risk > current_risk + 0.15:
            reasoning = f"Prediction: Risk score increases from {current_risk:.2f} to {predicted_risk:.2f}. Preemptive action required."
            action = "Reassess"
            self.logger.log_event("INFO", f"Proactive Step: {reasoning}")
            return action
        return None

